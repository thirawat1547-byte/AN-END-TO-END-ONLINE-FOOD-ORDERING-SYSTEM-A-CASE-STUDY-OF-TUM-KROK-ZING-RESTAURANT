# ===================================================
# 🔐 ไฟล์ .env ตัวอย่างสำหรับร้านตำครกซิ่ง
# ===================================================
# ⚠️ คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงของคุณ
# ⚠️ ห้าม commit ไฟล์ .env ขึ้น GitHub เด็ดขาด!
# ===================================================

# --- Google OAuth ---
# ได้จาก: https://console.cloud.google.com/apis/credentials
# ⚠️ ห้ามใส่เครื่องหมายคำพูด ("") ครอบค่า!
GOOGLE_CLIENT_ID=123456789-xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
GOOGLE_CALLBACK_URL=https://tumkrokzing.duckdns.org/api/v1/auth/google/callback

# --- Facebook OAuth ---
# ได้จาก: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=1234567890123456
FACEBOOK_APP_SECRET=abcdef1234567890abcdef1234567890
FACEBOOK_CALLBACK_URL=https://tumkrokzing.duckdns.org/api/v1/auth/facebook/callback

# --- LINE Login ---
# ได้จาก: https://developers.line.biz/console/
LINE_CHANNEL_ID=1234567890
LINE_CHANNEL_SECRET=abcdef1234567890abcdef1234567890
LINE_CALLBACK_URL=https://tumkrokzing.duckdns.org/api/v1/auth/line/callback
