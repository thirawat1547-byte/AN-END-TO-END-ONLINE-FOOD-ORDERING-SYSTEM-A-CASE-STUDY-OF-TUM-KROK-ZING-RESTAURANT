# URL ของ Backend API (ไม่ตั้งก็ได้ ระบบจะเลือกให้อัตโนมัติ)
# VITE_API_BASE_URL="http://localhost:5000/api/v1"

# Stripe publishable key (pk_test_... / pk_live_...)
# ถ้าไม่ตั้ง ระบบจะซ่อนตัวเลือกจ่ายด้วยบัตรในหน้าชำระเงิน
# ต้องตั้งก่อน build เพราะ Vite ฝังค่าลงในไฟล์ตอน build
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
