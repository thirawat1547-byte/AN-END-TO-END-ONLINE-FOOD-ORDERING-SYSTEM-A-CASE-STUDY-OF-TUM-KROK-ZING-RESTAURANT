# Server Configuration
PORT=5000
DATABASE_URL="mysql://root:yourpassword@localhost:3307/tum_krok_zing"
JWT_SECRET="your_jwt_secret_here"
SESSION_SECRET="your_session_secret_here"
FRONTEND_URL="http://localhost:5174"
ALLOW_MOCK_OAUTH=true

# --- Google OAuth ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# --- Facebook OAuth ---
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_CALLBACK_URL="http://localhost:5000/api/v1/auth/facebook/callback"

# --- LINE OAuth ---
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_CALLBACK_URL="http://localhost:5000/api/v1/auth/line/callback"

# --- Stripe (Optional) ---
STRIPE_SECRET_KEY="sk_test_placeholder"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
# ตอนพัฒนาในเครื่อง: stripe listen --forward-to localhost:5000/api/v1/transactions/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# --- OpenStreetMap Nominatim (แปลงพิกัดปักหมุดเป็นที่อยู่ ฟรี ไม่ต้องใช้คีย์) ---
NOMINATIM_USER_AGENT="TumKrokZing/1.0 (+https://tumkrokzing.duckdns.org)"

# --- OTP เบอร์โทรตอนสมัคร (test = ไม่ส่ง SMS ใช้รหัสคงที่) ---
OTP_MODE="test"
OTP_TEST_CODE="123456"

# --- Google Gemini AI (Chatbot "น้องส้มตำ AI") ---
# รับ API Key ฟรีที่ https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
