generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["views"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  user_id      Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(100)
  password     String   @db.VarChar(255)
  email        String?  @db.VarChar(150)
  phone_number String?  @db.VarChar(15)
  address      String?  @db.VarChar(255)
  role         String   @default("Customer") @db.VarChar(20)

  orders     Order[]
  deliveries Delivery[]

  @@map("USERS")
}

model Promotion {
  promo_id        Int      @id @default(autoincrement())
  code            String   @unique @db.VarChar(50)
  discount_type   String   @db.VarChar(20)
  discount_value  Decimal  @db.Decimal(10, 2)
  min_order_price Decimal  @default(0) @db.Decimal(10, 2)
  expiry_date     DateTime
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  orders Order[]

  @@map("PROMOTIONS")
}

model Table {
  table_id     Int    @id @default(autoincrement())
  table_number String @db.VarChar(10)
  capacity     Int
  status       String @default("AVAILABLE") @db.VarChar(20)

  orders Order[]

  @@map("TABLES")
}

model Category {
  category_id   Int    @id @default(autoincrement())
  category_name String @db.VarChar(100)

  menus Menu[]

  @@map("CATEGORIES")
}

model Menu {
  menu_id      Int     @id @default(autoincrement())
  category_id  Int
  menu_name    String  @db.VarChar(150)
  description  String? @db.Text
  price        Decimal @db.Decimal(10, 2)
  image_url    String? @db.VarChar(255)
  calories     Int?
  is_available Boolean @default(true)

  category      Category          @relation(fields: [category_id], references: [category_id])
  allergens     MenuAllergen[]
  ingredients   MenuIngredient[]
  order_items   OrderItem[]
  option_groups MenuOptionGroup[]

  @@index([category_id])
  @@map("MENUS")
}

model MenuOptionGroup {
  group_id    Int          @id @default(autoincrement())
  menu_id     Int
  group_name  String       @db.VarChar(100)
  is_required Boolean      @default(false)
  min_select  Int          @default(0)
  max_select  Int          @default(1)

  menu        Menu         @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade)
  options     MenuOption[]

  @@index([menu_id])
  @@map("MENU_OPTION_GROUPS")
}

model MenuOption {
  option_id        Int               @id @default(autoincrement())
  group_id         Int
  option_name      String            @db.VarChar(100)
  additional_price Decimal           @default(0.00) @db.Decimal(10, 2)
  is_available     Boolean           @default(true)

  group            MenuOptionGroup   @relation(fields: [group_id], references: [group_id], onDelete: Cascade)
  selected_items   OrderItemOption[]

  @@index([group_id])
  @@map("MENU_OPTIONS")
}

model Allergen {
  allergen_id   Int     @id @default(autoincrement())
  allergen_name String  @db.VarChar(100)
  icon_url      String? @db.VarChar(255)

  menus MenuAllergen[]

  @@map("ALLERGENS")
}

model MenuAllergen {
  menu_id     Int
  allergen_id Int

  menu     Menu      @relation(fields: [menu_id], references: [menu_id])
  allergen Allergen? @relation(fields: [allergen_id], references: [allergen_id])

  @@id([menu_id, allergen_id])
  @@index([menu_id])
  @@index([allergen_id])
  @@map("MENU_ALLERGENS")
}

model Order {
  order_id         Int           @id @default(autoincrement())
  user_id          Int?
  table_id         Int?
  promo_id         Int?
  order_type       String        @db.VarChar(20)
  status           String        @db.VarChar(30)
  subtotal         Decimal       @default(0.00) @db.Decimal(10, 2)
  discount_amount  Decimal       @default(0.00) @db.Decimal(10, 2)
  delivery_fee     Decimal       @default(0.00) @db.Decimal(10, 2)
  total_price      Decimal       @db.Decimal(10, 2)
  delivery_address String?       @db.VarChar(255)
  delivery_phone   String?       @db.VarChar(20)
  order_notes      String?       @db.Text
  rating           Int?          @db.TinyInt
  review_comment   String?       @db.Text
  reviewed_at      DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @default(now()) @updatedAt

  user        User?         @relation(fields: [user_id], references: [user_id])
  table       Table?        @relation(fields: [table_id], references: [table_id])
  promotion   Promotion?    @relation(fields: [promo_id], references: [promo_id])
  order_items OrderItem[]
  transaction Transaction[]
  delivery    Delivery?

  @@index([user_id])
  @@index([table_id])
  @@index([status])
  @@index([created_at])
  @@map("ORDERS")
}

model OrderItem {
  order_item_id Int      @id @default(autoincrement())
  order_id      Int
  menu_id       Int
  quantity      Int
  unit_price    Float    @default(0)
  notes         String?  @db.Text
  created_at    DateTime @default(now())

  order              Order             @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  menu               Menu              @relation(fields: [menu_id], references: [menu_id])
  order_item_options OrderItemOption[]

  @@map("ORDER_ITEMS")
}

model OrderItemOption {
  item_option_id Int         @id @default(autoincrement())
  order_item_id  Int
  option_id      Int?
  option_name    String      @db.VarChar(100)
  price          Decimal     @default(0.00) @db.Decimal(10, 2)

  order_item     OrderItem   @relation(fields: [order_item_id], references: [order_item_id], onDelete: Cascade)
  option         MenuOption? @relation(fields: [option_id], references: [option_id], onDelete: SetNull)

  @@index([order_item_id])
  @@index([option_id])
  @@map("ORDER_ITEM_OPTIONS")
}

model Delivery {
  delivery_id      Int       @id @default(autoincrement())
  order_id         Int       @unique
  rider_id         Int?
  delivery_status  String    @default("WAITING_RIDER") @db.VarChar(30)
  customer_name    String    @db.VarChar(100)
  customer_phone   String    @db.VarChar(20)
  delivery_address String    @db.VarChar(255)
  customer_lat     Decimal?  @db.Decimal(10, 7)
  customer_lng     Decimal?  @db.Decimal(10, 7)
  distance_km      Decimal   @default(0.00) @db.Decimal(5, 2)
  rider_fee        Decimal   @default(40.00) @db.Decimal(10, 2)
  proof_image_url  String?   @db.VarChar(255)
  assigned_at      DateTime?
  picked_up_at     DateTime?
  delivered_at     DateTime?

  order            Order     @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  rider            User?     @relation(fields: [rider_id], references: [user_id], onDelete: SetNull)

  @@index([rider_id])
  @@index([delivery_status])
  @@map("DELIVERIES")
}

model Transaction {
  transaction_id Int     @id @default(autoincrement())
  order_id       Int
  amount         Decimal @db.Decimal(10, 2)
  payment_method String  @db.VarChar(50)
  payment_status String  @db.VarChar(20)

  order Order @relation(fields: [order_id], references: [order_id])

  @@index([order_id])
  @@index([payment_status])
  @@map("TRANSACTIONS")
}

model Ingredient {
  ingredient_id Int      @id @default(autoincrement())
  name          String   @map("ingredient_name") @db.VarChar(100)
  quantity      Decimal  @map("quantity_in_stock") @default(0) @db.Decimal(10, 2)
  unit          String   @db.VarChar(50)
  min_quantity  Decimal  @map("reorder_level") @default(5) @db.Decimal(10, 2)
  updated_at    DateTime @map("last_updated") @default(now()) @updatedAt

  menu_ingredients MenuIngredient[]

  @@map("INGREDIENTS")
}

model MenuIngredient {
  menu_id       Int
  ingredient_id Int
  quantity_used Decimal @db.Decimal(10, 2)

  menu       Menu        @relation(fields: [menu_id], references: [menu_id])
  ingredient Ingredient? @relation(fields: [ingredient_id], references: [ingredient_id])

  @@id([menu_id, ingredient_id])
  @@index([menu_id])
  @@index([ingredient_id])
  @@map("MENU_INGREDIENTS")
}

// 1. สรุปยอดขายรวม (ออเดอร์)
view OrderSummary {
  order_id     Int      @unique
  table_number String?
  total_price  Decimal  @db.Decimal(10, 2)
  status       String
  order_date   DateTime

  @@map("ORDER_SUMMARIES_VIEW")
}

// 2. รายการใบเสร็จ / เช็คบิล
view TransactionReceipt {
  transaction_id Int      @unique
  order_id       Int
  customer_name  String?
  total_amount   Decimal  @db.Decimal(10, 2)
  payment_method String
  payment_status String
  payment_date   DateTime

  @@map("TRANSACTION_RECEIPTS_VIEW")
}

// 3. เมนูยอดฮิต (ขายดี)
view TopSellingMenu {
  menu_id       Int     @unique
  menu_name     String
  category_name String
  total_sold    Int
  total_revenue Decimal @db.Decimal(10, 2)

  @@map("TOP_SELLING_MENUS_VIEW")
}

// 4. แจ้งเตือนวัตถุดิบใกล้หมด
view LowStockAlert {
  ingredient_id     Int     @unique
  ingredient_name   String
  quantity_in_stock Decimal @db.Decimal(10, 2)
  reorder_level     Decimal @db.Decimal(10, 2)
  unit              String

  @@map("LOW_STOCK_ALERTS_VIEW")
}

// 5. สถานะโต๊ะแบบเรียลไทม์
view LiveTableStatus {
  table_id         Int      @unique
  table_number     String
  capacity         Int
  current_status   String
  current_order_id Int?
  current_total    Decimal? @db.Decimal(10, 2)

  @@map("LIVE_TABLE_STATUS_VIEW")
}

// 6. การตั้งค่าร้านค้า (Store Settings)
model StoreSetting {
  id                  Int      @id @default(1)
  store_name          String   @default("ร้านตำครกซิ่ง (Tum Krok Zing)") @db.VarChar(150)
  tagline             String?  @default("แซ่บนัว ถึงใจ อาหารอีสานแท้รสเด็ด") @db.VarChar(255)
  promptpay_number    String?  @default("081-234-5678") @db.VarChar(50)
  promptpay_name      String?  @default("นายธีรวัฒน์ แสนคำเฮียง (ตำครกซิ่ง)") @db.VarChar(150)
  tax_id              String?  @default("0105566099881") @db.VarChar(50)
  address             String?  @default("123/45 ถนนแจ้งวัฒนะ แขวงทุ่งสองห้อง เขตหลักสี่ กรุงเทพมหานคร 10210") @db.VarChar(255)
  phone               String?  @default("02-987-6543, 081-234-5678") @db.VarChar(100)
  open_time           String?  @default("10:30") @db.VarChar(20)
  close_time          String?  @default("22:00") @db.VarChar(20)
  is_open             Boolean  @default(true)
  base_delivery_fee   Decimal  @default(20.00) @db.Decimal(10, 2)
  delivery_fee_per_km Decimal  @default(10.00) @db.Decimal(10, 2)
  max_delivery_km     Decimal  @default(15.00) @db.Decimal(5, 2)
  min_order_delivery  Decimal  @default(100.00) @db.Decimal(10, 2)
  base_rider_fee      Decimal  @default(40.00) @db.Decimal(10, 2)
  vat_rate            Decimal? @default(7.00) @db.Decimal(5, 2)
  updated_at          DateTime @default(now()) @updatedAt

  @@map("STORE_SETTINGS")
}